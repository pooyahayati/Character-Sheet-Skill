{
  "package_name": "character-sheet-skill",
  "display_name": "Character Sheet Skill",
  "version": "1.1.0",
  "entrypoint": "SKILL.md",
  "author": "Pooya Hayati | پویا حیاتی",
  "homepage": "https://github.com/pooyahayati/Character-Sheet-Skill",
  "runtime_files": [
    "SKILL.md",
    "README.md",
