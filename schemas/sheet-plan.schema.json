{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pooyahayati/Character-Sheet-Skill/schemas/sheet-plan.schema.json",
  "title": "Character Sheet Plan",
  "type": "object",
  "required": [
    "request_id",
    "character_id",
    "selected_level",
    "layout_scope",
    "panels"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "character_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_level": {
      "enum": [
        "Base",
        "Advanced",
        "Full"
      ]
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "panel_id",
          "panel_type",
          "required",
          "evidence_expectation",
          "source_reference_ids",
          "reconstruction_allowed",
          "generation_route",
          "identity_anchor_ids",
          "camera_lighting_contract_file"
        ],
        "properties": {
          "panel_id": {
            "type": "string",
            "minLength": 1
          },
          "panel_type": {
            "enum": [
              "Canonical-Face",
              "Face-Front",
              "Face-Three-Quarter-Left",
              "Face-Three-Quarter-Right",
              "Face-Profile-Left",
              "Face-Profile-Right",
              "Eye-Detail",
              "Mouth-Lip-Detail",
              "Smile",
              "Hair",
              "Body-Front",
              "Body-Side",
              "Body-Back",
              "Hands-Nails",
              "Distinctive-Features",
              "Modeling-Pose",
              "Metadata",
              "Color-Palette",
              "Pose-Diagnostic"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "evidence_expectation": {
            "enum": [
              "Observed-Preferred",
              "Observed-Required",
              "Reconstruction-Permitted",
              "Metadata-Only"
            ]
          },
          "source_reference_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "reconstruction_allowed": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          },
          "pose_contract_file": {
            "type": [
              "string",
              "null"
            ]
          },
          "generation_route": {
            "enum": [
              "R1-Identity-Reference",
              "R2-Identity-Plus-2D-Pose",
              "R3-Identity-Plus-3D-Geometry",
              "R4-Identity-Preserving-Local-Edit",
              "R5-Subject-Specific-Adapter",
              "R6-Dedicated-3D-Avatar"
            ]
          },
          "pose_difficulty": {
            "enum": [
              "P0-Neutral",
              "P1-Simple",
              "P2-Dynamic",
              "P3-Seated-Leaning",
              "P4-Self-Occlusion",
              "P5-Extreme-Articulation",
              "Not-Applicable"
            ]
          },
          "identity_anchor_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "camera_lighting_contract_file": {
            "type": [
              "string",
              "null"
            ]
          },
          "clothing_behavior_file": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "pose_readiness_target": {
      "enum": [
        "Not-Ready",
        "Basic",
        "Strong",
        "Production"
      ]
    },
    "layout_scope": {
      "enum": [
        "Compact",
        "Complete"
      ]
    }
  },
  "additionalProperties": false
}