{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pooyahayati/Character-Sheet-Skill/schemas/build-request.schema.json",
  "title": "Character Sheet Build Request",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "goal",
    "requested_level",
    "layout_scope",
    "output_mode",
    "budget_mode",
    "required_details",
    "subject_height",
    "subject_authorization",
    "age_handling"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "enum": [
        "Face-Reference",
        "Character-Reference",
        "Modeling-Reference",
        "Revision",
        "Level-Upgrade",
        "Custom"
      ]
    },
    "requested_level": {
      "enum": [
        "Auto",
        "Base",
        "Advanced",
        "Full"
      ]
    },
    "layout_scope": {
      "enum": [
        "Auto",
        "Compact",
        "Complete"
      ]
    },
    "output_mode": {
      "enum": [
        "Quick-Sheet",
        "Production-Package"
      ],
      "default": "Quick-Sheet"
    },
    "budget_mode": {
      "enum": [
        "Economy",
        "Balanced",
        "Maximum-Fidelity"
      ],
      "default": "Balanced"
    },
    "required_details": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "Face-Angles",
          "Expressions",
          "Smile",
          "Body",
          "Back-View",
          "Hair",
          "Hands-Nails",
          "Feet",
          "Distinctive-Features",
          "Modeling-Poses",
          "Measurements"
        ]
      }
    },
    "subject_height": {
      "type": "object",
      "required": [
        "status",
        "value_cm"
      ],
      "properties": {
        "status": {
          "enum": [
            "User-Provided",
            "Asked-Unknown",
            "Not-Applicable"
          ]
        },
        "value_cm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 50,
          "maximum": 260
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "User-Provided"
              }
            }
          },
          "then": {
            "properties": {
              "value_cm": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "Asked-Unknown",
                  "Not-Applicable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value_cm": {
                "type": "null"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "target_appearance_epoch": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_authorization": {
      "enum": [
        "Self",
        "Authorized-by-Subject",
        "Licensed-or-Permitted",
        "Unknown"
      ]
    },
    "age_handling": {
      "enum": [
        "Adult-Confirmed",
        "Minor",
        "Unknown"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}