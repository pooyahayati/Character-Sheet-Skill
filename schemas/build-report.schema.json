{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pooyahayati/Character-Sheet-Skill/schemas/build-report.schema.json",
  "title": "Character Sheet Build Report",
  "type": "object",
  "required": [
    "request_id",
    "character_id",
    "profile_version",
    "selected_level",
    "status",
    "reference_ids",
    "panel_results",
    "limitations"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "character_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_version": {
      "type": "string",
      "minLength": 1
    },
    "selected_level": {
      "enum": [
        "Base",
        "Advanced",
        "Full"
      ]
    },
    "status": {
      "enum": [
        "Approved",
        "Approved-With-Limits",
        "Blocked"
      ]
    },
    "reference_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "panel_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "panel_id",
          "gate_result",
          "included_in_final",
          "assessment_method"
        ],
        "properties": {
          "panel_id": {
            "type": "string"
          },
          "gate_result": {
            "enum": [
              "PASS",
              "PASS_WITH_LIMITS",
              "BLOCK"
            ]
          },
          "included_in_final": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          },
          "assessment_method": {
            "enum": [
              "Automated-Metric",
              "Human-Review",
              "Model-Visual-Review",
              "Hybrid"
            ]
          },
          "metric_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "metric",
                "result"
              ],
              "properties": {
                "metric": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                },
                "threshold": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                },
                "result": {
                  "enum": [
                    "PASS",
                    "PASS_WITH_LIMITS",
                    "BLOCK",
                    "NOT_APPLICABLE"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "omitted_panels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision_parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "pose_readiness": {
      "enum": [
        "Not-Ready",
        "Basic",
        "Strong",
        "Production"
      ]
    },
    "visual_benchmark_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "body_proxy_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation_routes_used": {
      "type": "array",
      "items": {
        "enum": [
          "R1-Identity-Reference",
          "R2-Identity-Plus-2D-Pose",
          "R3-Identity-Plus-3D-Geometry",
          "R4-Identity-Preserving-Local-Edit",
          "R5-Subject-Specific-Adapter",
          "R6-Dedicated-3D-Avatar"
        ]
      },
      "uniqueItems": true
    },
    "cross_panel_identity_matrix_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity_anchor_bank_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "camera_lighting_contract_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}