{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pooyahayati/Character-Sheet-Skill/schemas/character-profile.schema.json",
  "title": "Character Sheet Canonical Profile",
  "type": "object",
  "required": [
    "schema_version",
    "build_request_file",
    "character_id",
    "version",
    "level",
    "identity",
    "editable",
    "evidence",
    "qc",
    "pose_assets",
    "production_assets"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "character_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "Base",
        "Advanced",
        "Full"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "face_geometry": {
          "$ref": "#/$defs/attributeGroup"
        },
        "facial_proportions": {
          "$ref": "#/$defs/facialProportionGroup"
        },
        "eyes": {
          "$ref": "#/$defs/attributeGroup"
        },
        "nose": {
          "$ref": "#/$defs/attributeGroup"
        },
        "mouth_lips": {
          "$ref": "#/$defs/attributeGroup"
        },
        "smile_expression": {
          "$ref": "#/$defs/attributeGroup"
        },
        "natural_asymmetry": {
          "$ref": "#/$defs/attributeGroup"
        },
        "distinctive_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "hair_identity": {
          "$ref": "#/$defs/attributeGroup"
        },
        "body_geometry": {
          "$ref": "#/$defs/attributeGroup"
        }
      },
      "additionalProperties": false,
      "required": [
        "face_geometry",
        "facial_proportions",
        "eyes",
        "nose",
        "mouth_lips",
        "smile_expression",
        "natural_asymmetry",
        "distinctive_features",
        "hair_identity",
        "body_geometry"
      ]
    },
    "editable": {
      "type": "object",
      "required": [
        "appearance",
        "body"
      ],
      "properties": {
        "appearance": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/attribute"
          }
        },
        "body": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/attribute"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "reference_analysis_file",
        "primary_references",
        "validation_references",
        "excluded_references",
        "coverage"
      ],
      "properties": {
        "primary_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage": {
          "type": "object",
          "required": [
            "face",
            "eyes",
            "smile",
            "profile",
            "body",
            "hands_nails"
          ],
          "properties": {
            "face": {
              "$ref": "#/$defs/coverageLevel"
            },
            "eyes": {
              "$ref": "#/$defs/coverageLevel"
            },
            "smile": {
              "$ref": "#/$defs/coverageLevel"
            },
            "profile": {
              "$ref": "#/$defs/coverageLevel"
            },
            "body": {
              "$ref": "#/$defs/coverageLevel"
            },
            "hands_nails": {
              "$ref": "#/$defs/coverageLevel"
            }
          },
          "additionalProperties": false
        },
        "target_appearance_epoch": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_analysis_file": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "qc": {
      "type": "object",
      "required": [
        "pre_generation_face_gate"
      ],
      "properties": {
        "pre_generation_face_gate": {
          "$ref": "#/$defs/gate"
        },
        "panel_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "panel_id",
              "gate"
            ],
            "properties": {
              "panel_id": {
                "type": "string"
              },
              "gate": {
                "$ref": "#/$defs/gate"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "revisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revision"
      }
    },
    "build_request_file": {
      "type": "string",
      "minLength": 1
    },
    "pose_assets": {
      "type": "object",
      "required": [
        "body_proxy_file",
        "pose_readiness_file"
      ],
      "properties": {
        "body_proxy_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "pose_readiness_file": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "production_assets": {
      "type": "object",
      "required": [
        "identity_anchor_bank_file",
        "cross_panel_identity_matrix_file",
        "extremity_profile_file",
        "skin_identity_file",
        "hair_dynamics_file",
        "default_clothing_behavior_file"
      ],
      "properties": {
        "identity_anchor_bank_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "cross_panel_identity_matrix_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "extremity_profile_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "skin_identity_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "hair_dynamics_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_clothing_behavior_file": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "evidenceBasis": {
      "enum": [
        "Observed",
        "Cross-Validated",
        "Estimated",
        "Reconstructed",
        "Unverified",
        "User-Provided"
      ]
    },
    "revisionState": {
      "enum": [
        "Original",
        "Edited"
      ]
    },
    "lockState": {
      "enum": [
        "Identity-Locked",
        "Appearance-Editable",
        "Body-Editable",
        "Unlocked"
      ]
    },
    "confidence": {
      "enum": [
        "High",
        "Medium",
        "Low",
        "Unknown"
      ]
    },
    "checkResult": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_EVALUABLE"
      ]
    },
    "attribute": {
      "type": "object",
      "required": [
        "evidence_basis",
        "revision_state",
        "lock_state",
        "confidence"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/scalarValue"
        },
        "evidence_basis": {
          "$ref": "#/$defs/evidenceBasis"
        },
        "revision_state": {
          "$ref": "#/$defs/revisionState"
        },
        "lock_state": {
          "$ref": "#/$defs/lockState"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "consistency": {
          "$ref": "#/$defs/confidence"
        },
        "source_images": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "attributeGroup": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/attribute"
      }
    },
    "feature": {
      "type": "object",
      "required": [
        "name",
        "subject_side",
        "evidence_basis",
        "revision_state",
        "lock_state",
        "confidence"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "subject_side": {
          "enum": [
            "Left",
            "Right",
            "Center",
            "Bilateral",
            "Unknown"
          ]
        },
        "location": {
          "type": "string"
        },
        "evidence_basis": {
          "$ref": "#/$defs/evidenceBasis"
        },
        "revision_state": {
          "$ref": "#/$defs/revisionState"
        },
        "lock_state": {
          "$ref": "#/$defs/lockState"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "source_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": [
        "result",
        "critical_checks",
        "limitations",
        "evidence_used",
        "reason"
      ],
      "properties": {
        "result": {
          "enum": [
            "PASS",
            "PASS_WITH_LIMITS",
            "BLOCK"
          ]
        },
        "critical_checks": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "global_identity",
              "face_geometry",
              "facial_proportions",
              "left_eye",
              "right_eye",
              "eye_spacing",
              "nose",
              "mouth_lips",
              "smile_expression",
              "jaw_chin",
              "hairline",
              "distinctive_features",
              "natural_asymmetry",
              "body_geometry",
              "pose_expression_consistency",
              "full_body_face_fidelity",
              "laterality",
              "pose_accuracy",
              "physical_plausibility",
              "occlusion",
              "hand_anatomy",
              "foot_anatomy",
              "photorealism",
              "cross_pose_identity"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/checkResult"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "coverageLevel": {
      "enum": [
        "None",
        "Weak",
        "Moderate",
        "Strong"
      ]
    },
    "scalarValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "maxItems": 32
        }
      ]
    },
    "measurementContext": {
      "type": "object",
      "required": [
        "reference_view",
        "geometry_validity",
        "distortion_risk",
        "normalization"
      ],
      "properties": {
        "reference_view": {
          "enum": [
            "Front",
            "Near-Front",
            "Three-Quarter",
            "Profile",
            "Other"
          ]
        },
        "geometry_validity": {
          "enum": [
            "Valid",
            "Limited",
            "Invalid"
          ]
        },
        "distortion_risk": {
          "enum": [
            "None",
            "Low",
            "Medium",
            "High",
            "Unknown"
          ]
        },
        "normalization": {
          "type": "string",
          "minLength": 1
        },
        "source_image": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "facialProportionAttribute": {
      "type": "object",
      "required": [
        "evidence_basis",
        "revision_state",
        "lock_state",
        "confidence",
        "measurement_context"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/scalarValue"
        },
        "evidence_basis": {
          "$ref": "#/$defs/evidenceBasis"
        },
        "revision_state": {
          "$ref": "#/$defs/revisionState"
        },
        "lock_state": {
          "$ref": "#/$defs/lockState"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "consistency": {
          "$ref": "#/$defs/confidence"
        },
        "source_images": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        },
        "measurement_context": {
          "$ref": "#/$defs/measurementContext"
        }
      },
      "additionalProperties": false
    },
    "facialProportionGroup": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/facialProportionAttribute"
      }
    },
    "change": {
      "type": "object",
      "required": [
        "path",
        "scope",
        "previous_value",
        "new_value"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "Appearance",
            "Body",
            "Identity"
          ]
        },
        "previous_value": {
          "$ref": "#/$defs/scalarValue"
        },
        "new_value": {
          "$ref": "#/$defs/scalarValue"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "object",
      "required": [
        "version",
        "parent",
        "request_id",
        "revision_type",
        "changes",
        "qc_result"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "revision_type": {
          "enum": [
            "Minor",
            "Major"
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          },
          "minItems": 1
        },
        "qc_result": {
          "enum": [
            "PASS",
            "PASS_WITH_LIMITS",
            "BLOCK"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}