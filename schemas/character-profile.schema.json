{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pooyahayati/Character-Sheet-Skill/schemas/character-profile.schema.json",
  "title": "Character Sheet Canonical Profile",
  "type": "object",
  "required": [
    "schema_version",
    "character_id",
    "version",
    "level",
    "identity",
    "editable",
    "evidence",
    "qc"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "character_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "Base",
        "Advanced",
        "Full"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "face_geometry": {
          "$ref": "#/$defs/attributeGroup"
        },
        "facial_proportions": {
          "$ref": "#/$defs/attributeGroup"
        },
        "eyes": {
          "$ref": "#/$defs/attributeGroup"
        },
        "nose": {
          "$ref": "#/$defs/attributeGroup"
        },
        "mouth_lips": {
          "$ref": "#/$defs/attributeGroup"
        },
        "smile_expression": {
          "$ref": "#/$defs/attributeGroup"
        },
        "natural_asymmetry": {
          "$ref": "#/$defs/attributeGroup"
        },
        "distinctive_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "hair_identity": {
          "$ref": "#/$defs/attributeGroup"
        },
        "body_geometry": {
          "$ref": "#/$defs/attributeGroup"
        }
      },
      "additionalProperties": false
    },
    "editable": {
      "type": "object",
      "required": [
        "appearance",
        "body"
      ],
      "properties": {
        "appearance": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/attribute"
          }
        },
        "body": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/attribute"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "primary_references",
        "validation_references",
        "excluded_references",
        "coverage"
      ],
      "properties": {
        "primary_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage": {
          "type": "object"
        },
        "target_appearance_epoch": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "qc": {
      "type": "object",
      "required": [
        "pre_generation_face_gate"
      ],
      "properties": {
        "pre_generation_face_gate": {
          "$ref": "#/$defs/gate"
        },
        "panel_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "panel_id",
              "gate"
            ],
            "properties": {
              "panel_id": {
                "type": "string"
              },
              "gate": {
                "$ref": "#/$defs/gate"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "changes"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "evidenceBasis": {
      "enum": [
        "Observed",
        "Cross-Validated",
        "Estimated",
        "Reconstructed",
        "Unverified",
        "User-Provided"
      ]
    },
    "revisionState": {
      "enum": [
        "Original",
        "Edited"
      ]
    },
    "lockState": {
      "enum": [
        "Identity-Locked",
        "Appearance-Editable",
        "Body-Editable",
        "Unlocked"
      ]
    },
    "confidence": {
      "enum": [
        "High",
        "Medium",
        "Low",
        "Unknown"
      ]
    },
    "checkResult": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_EVALUABLE"
      ]
    },
    "attribute": {
      "type": "object",
      "required": [
        "evidence_basis",
        "revision_state",
        "lock_state",
        "confidence"
      ],
      "properties": {
        "value": {},
        "evidence_basis": {
          "$ref": "#/$defs/evidenceBasis"
        },
        "revision_state": {
          "$ref": "#/$defs/revisionState"
        },
        "lock_state": {
          "$ref": "#/$defs/lockState"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "consistency": {
          "$ref": "#/$defs/confidence"
        },
        "source_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "attributeGroup": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/attribute"
      }
    },
    "feature": {
      "type": "object",
      "required": [
        "name",
        "subject_side",
        "evidence_basis",
        "revision_state",
        "lock_state",
        "confidence"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "subject_side": {
          "enum": [
            "Left",
            "Right",
            "Center",
            "Bilateral",
            "Unknown"
          ]
        },
        "location": {
          "type": "string"
        },
        "evidence_basis": {
          "$ref": "#/$defs/evidenceBasis"
        },
        "revision_state": {
          "$ref": "#/$defs/revisionState"
        },
        "lock_state": {
          "$ref": "#/$defs/lockState"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "source_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": [
        "result",
        "critical_checks",
        "limitations",
        "evidence_used",
        "reason"
      ],
      "properties": {
        "result": {
          "enum": [
            "PASS",
            "PASS_WITH_LIMITS",
            "BLOCK"
          ]
        },
        "critical_checks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/checkResult"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}